<Window x:Class="WPF_Controls_Memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Controls_Memoriajatek"
        mc:Ignorable="d"
        Title="Memóriajáték" Height="450" Width="800">
    <DockPanel>
		  <Menu DockPanel.Dock="Top">
			  <MenuItem Header="Kilép" Click="miKilép_Click"/>
			  <MenuItem Header="Kever" Click="miKever_Click"/>
			  <MenuItem Header="Kérdez" Click="miKérdez_Click"/>
			  <MenuItem Header="Súgó" Click="miSúgó_Click"/>
		  </Menu>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<Image x:Name="im00" Grid.Row="0" Grid.Column="0"
							/>
				<Image x:Name="im01" Grid.Row="0" Grid.Column="1"/>
				<Image x:Name="im02" Grid.Row="0" Grid.Column="2"/>
				<Image x:Name="im03" Grid.Row="0" Grid.Column="3"/>
				<Image x:Name="im10" Grid.Row="1" Grid.Column="0"/>
				<Image x:Name="im11" Grid.Row="1" Grid.Column="1"/>
				<Image x:Name="im12" Grid.Row="1" Grid.Column="2"/>
				<Image x:Name="im13" Grid.Row="1" Grid.Column="3"/>
			</Grid>
    </DockPanel>
</Window>
